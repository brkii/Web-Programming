Options -Indexes
DirectorySlash Off
RewriteEngine On
RewriteRule ^public/v1/docs$ %{REQUEST_URI}/ [R=301,L]
# /services is an API resource as well as a PHP source directory.
RewriteRule ^services(?:/|$) index.php [QSA,L]
RewriteRule ^(?:config|dao|services|utils|routes|middleware|logs|vendor)(?:/|$) - [F,L]
RewriteRule ^composer\.(?:json|lock)$ - [F,L]
RewriteRule ^public/v1/docs/(?:paths/|doc_setup\.php) - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
